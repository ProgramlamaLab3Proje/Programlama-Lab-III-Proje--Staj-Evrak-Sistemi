
@page
@model StajEvrakSistemi.Pages.Student.UploadModel

@{
    ViewData["Title"] = "Ek-16 Belge Yükleme";
}

<div class="container mt-5">
    <h2>Ek-16 Belge Yükleme</h2>

    <p>Staj başvurunuz için Ek-16 belgenizi yükleyiniz.</p>

    <form method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label asp-for="UploadedFile" class="form-label">
                Ek-16 Belgesi
            </label>

            <input asp-for="UploadedFile"
                   type="file"
                   class="form-control"
                   accept=".doc,.docx,.pdf,.jpg,.jpeg,.png"/>

            <span asp-validation-for="UploadedFile"
                  class="text-danger"></span>

            <small class="form-text text-muted">
                İzin verilen formatlar: DOC, DOCX, PDF, JPG, JPEG, PNG.
            </small>
            <div id="clientMessage"
                class="alert alert-danger mt-3"
                style="display:none;">
            </div>
        </div>

        <button type="submit" class="btn btn-primary">
            Belgeyi Yükle
        </button>
    </form>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info mt-3">
            @Model.Message
        </div>
    }
</div>
<script>
    const fileInput = document.getElementById("UploadedFile");
    const uploadForm = document.querySelector("form");
    const clientMessage = document.getElementById("clientMessage");

    const maxFileSize = 20 * 1024 * 1024;

    function checkFileSize() {
        const file = fileInput.files[0];

        if (file && file.size > maxFileSize) {
            clientMessage.textContent =
                "Dosya boyutu 20 MB sınırını aşamaz.";
            clientMessage.style.display = "block";
            return false;
        }

        clientMessage.style.display = "none";
        return true;
    }

    fileInput.addEventListener("change", checkFileSize);

    uploadForm.addEventListener("submit", function (event) {
        if (!checkFileSize()) {
            event.preventDefault();
        }
    });
</script>
