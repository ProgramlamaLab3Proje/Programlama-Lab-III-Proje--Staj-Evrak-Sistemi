@page
@model StajEvrakSistemi.Pages.Admin.StudentRecordsModel
@{
    ViewData["Title"] = "Öğrenci Kayıtları";
}

<div class="container mt-4">
    <h2>Öğrenci Verileri</h2>

    <form method="post" enctype="multipart/form-data">
        <input type="file" asp-for="Csvdosyasi" accept=".csv" class="form-control mb-2" />
        <p>(CSV türündeki dosyalar kabul edilmektedir. Dosya boyutu 5 mb sınırının altında olmalıdır)</p>
        <button type="submit" class="btn btn-primary">Yükle</button>
    </form>
    
    @if (Model.Message != null)
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") mt-3">
            @Model.Message
        </div>
    }
</div>